{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias `@/` — espelha o resolve.alias do vite.config.ts. Os dois precisam
       existir: um sozinho faz editor e build discordarem em silencio.
       Sem `baseUrl`: depreciado no TS 7, e `paths` ja resolve relativo a este arquivo. */
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/lib/vintage-imports/Knob.tsx"]
}
